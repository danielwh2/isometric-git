---
/**
 * SectionHead: how every section opens: the h2, with no numeral or label above it.
 *
 *   <SectionHead title="How to read it" />
 *
 * Props
 *   title  the h2
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="head">
  <h2>{title}</h2>
</div>

<style>
  h2 { font-size: clamp(22px, 3vw, 30px); line-height: 1.12; letter-spacing: -0.035em; text-wrap: balance; }
</style>
