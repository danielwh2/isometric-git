---
/**
 * Button: the page's one button. Small on purpose: the hit area grows, the control does not.
 *
 *   <Button variant="solid" data-open>Open a folder</Button>
 *   <Button id="fit">Fit</Button>
 *   <Button id="zoom-in" label="Zoom in">+</Button>
 *
 * Props
 *   variant  "solid" (the ink key, for the page's call to action) or "quiet" (hairline). Default "quiet".
 *   id       forwarded, so a script can bind to it.
 *   label    an aria-label, for a button whose face is a symbol.
 *
 * Any data-* attribute passes straight through.
 *
 * The .button class is global, not scoped, so the factory's own controls can
 * carry it without one component importing another.
 */
interface Props {
  variant?: "solid" | "quiet";
  id?: string;
  label?: string;
  [data: `data-${string}`]: string | boolean;
}
const { variant = "quiet", id, label, ...data } = Astro.props;
---

<button type="button" class:list={["button", variant === "solid" && "button-solid"]} id={id} aria-label={label} {...data}><slot /></button>

<style is:global>
  .button { position: relative; padding: 2px 9px; font-size: 12px; background: var(--bg); border: 1px solid var(--ink); border-radius: var(--radius); cursor: pointer; white-space: nowrap; transition: background var(--quick) var(--ease), color var(--quick) var(--ease), transform var(--quick) var(--ease); }
  .button::after { content: ""; position: absolute; inset: -11px -3px; } /* a 44px target around a 24px control */
  .button:active { transform: scale(0.97); }
  .button:disabled { opacity: 0.4; pointer-events: none; }
  .button-solid { padding: 7px 14px; font-size: 13px; background: var(--ink); color: var(--bg); }
  .button-solid::after { inset: -6px -3px; }
  @media (hover: hover) {
    .button:hover { background: var(--ink); color: var(--bg); }
    .button-solid:hover { background: var(--bg); color: var(--ink); }
  }
  @media (prefers-reduced-motion: reduce) { .button { transition: none; } }
</style>
